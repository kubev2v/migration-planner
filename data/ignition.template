variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      {{if .RhcosPassword}}
      password_hash: "{{.RhcosPassword}}"
      {{end}}
      {{if .SshKey}}
      ssh_authorized_keys:
        - {{.SshKey}}
      {{end}}

systemd:
  units:
    - name: var-lib-data-resize.service
      enabled: true
      contents: |
        [Unit]
        Description=Resize data disk filesystem
        Before=var-lib-data.mount
        DefaultDependencies=no
        After=local-fs.target

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c '/usr/sbin/resize2fs -f {{ .PersistentDiskDevice }}'
        RemainAfterExit=true

        [Install]
        RequiredBy=var-lib-data.mount
    - name: var-lib-data.mount
      enabled: true
      contents: |
        [Unit]
        Requires=var-lib-data-resize.service
        DefaultDependencies=no
        After=var-lib-data-resize.service

        [Mount]
        What=/dev/disk/by-label/DATA
        Where=/var/lib/data
        Type=ext4

        [Install]
        WantedBy=local-fs.target

    - name: planner-agent-bootstrap.service
      enabled: true
      contents: |
        [Unit]
        Description=Podman custom graphroot SELinux setup and agent ID
        Requires=var-lib-data.mount
        After=var-lib-data.mount

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/podman-custom-selinux.sh
        ExecStart=/bin/bash -c 'cat /sys/class/dmi/id/product_uuid > /var/lib/data/agent/agent_id'
        ExecStart=/bin/bash -c 'chown -R core:core /var/lib/data'

        [Install]
        WantedBy=multi-user.target
storage:
  filesystems:
    - path: /var/lib/data
      device: {{ .PersistentDiskDevice }}
      format: ext4
      label: "DATA"

  links:
    - path: /home/core/.config/systemd/user/default.target.wants/planner-agent-image-load.service
      target: /home/core/.config/systemd/user/planner-agent-image-load.service
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user/default.target.wants/planner-agent-image-update.path
      target: /home/core/.config/systemd/user/planner-agent-image-update.path
      user:
        name: core
      group:
        name: core
  directories:
    - path: /var/lib/data/agent
      user:
        name: core
      group:
        name: core
    - path: /var/lib/data/agent/updates
      user:
        name: core
      group:
        name: core
    - path: /var/lib/data/agent/updates/.staging
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user/default.target.wants
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.migration-planner
      overwrite: true
      user:
        name: core
      group:
        name: core
  files:
    {{if .IpAddress}}
    - path: /etc/NetworkManager/system-connections/static.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=static
          type=ethernet
          autoconnect=true

          [ipv4]
          method=manual
          address1={{.IpAddress}}/{{.SubnetMask}},{{.DefaultGateway}}
          dns={{.Dns}};

          [ipv6]
          method=disabled
    {{end}}
    {{if .InsecureRegistry}}
    - path: /etc/containers/registries.conf.d/myregistry.conf
      overwrite: true
      contents:
        inline: |
          [[registry]]
          location = "{{.InsecureRegistry}}"
          insecure = true
    {{end}}
    - path: /home/core/.config/containers/storage.conf
      overwrite: true
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [storage]
          driver = "overlay"
          runroot = "/var/lib/data/run"
          graphroot = "/var/lib/data/containers/storage"
    - path: /usr/local/sbin/podman-custom-selinux.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          /usr/bin/mkdir -p /var/lib/data/containers/storage /var/lib/data/run
          if [[ ! -f /var/lib/data/podman_storage_selinux_ready ]]; then

            /usr/sbin/semanage fcontext -a -e /var/lib/containers/storage /var/lib/data/containers 2>/dev/null || true
            /usr/sbin/restorecon -vRF /var/lib/data/containers/storage
            /usr/bin/touch /var/lib/data/podman_storage_selinux_ready
          fi
    - path: /usr/local/sbin/load-planner-agent-image.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          if ! command -v skopeo >/dev/null 2>&1; then
            echo "Error: skopeo command not found" >&2
            exit 1
          fi

          readonly IMAGE_TAR=/run/media/iso/images/migration-planner-agent.tar

          if [[ ! -f "$IMAGE_TAR" ]]; then
            echo "Error: Image tar not found at ${IMAGE_TAR}" >&2
            exit 1
          fi

          # Skip if image was already updated (preserves updates across reboots)
          if podman image exists "{{.AgentImage}}" 2>/dev/null; then
            echo "Image {{.AgentImage}} already exists in storage, skipping ISO copy"
            exit 0
          fi

          mkdir -p /var/lib/data/tmp

          exec skopeo copy --tmpdir /var/lib/data/tmp/ \
            "oci-archive:${IMAGE_TAR}" \
            "containers-storage:{{.AgentImage}}"
    - path: /usr/local/sbin/update-planner-agent-image.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          # The agent stages archives in updates/.staging/ and renames them here once validated,
          # so every *.tar in this directory is complete and approved for installation.
          readonly UPDATE_DIR=/var/lib/data/agent/updates

          # Preserve stdout for JSON reports; retain the last 4096 stderr bytes for the
          # journal and status.json. pipefail preserves the command's failure.
          run_with_diagnostics() {
            "$@" 2>&1 1>&3 | tail -c 4096 | tee "$diagnostics" >&2
          } 3>&1

          command_error() {
            local detail
            detail=$(cat "$diagnostics") || detail=""
            printf '%s%s' "$1" "${detail:+: $detail}"
          }

          # Inspect the running container, not the mutable image tag: a rollback can retag it.
          running_image() {
            local container image
            container=$(podman container inspect planner-agent) || return 1
            image=$(jq -er '.[0] | select(.State.Running == true) | .Image' <<< "$container") || return 1
            podman image inspect "$image" | jq -ce '
              .[0] | {digest: .Digest, version: .Labels["org.opencontainers.image.version"]}
              | select((.digest | type == "string" and length > 0)
                and (.version | type == "string" and length > 0))'
          }

          # Publish the attempt and running image atomically. Failed/unchanged attempts retain
          # the last successful update, including its image identity and completion time.
          write_status() {
            local previous=/dev/null tmp
            [[ ! -f "${UPDATE_DIR}/status.json" ]] || previous="${UPDATE_DIR}/status.json"
            tmp=$(mktemp "${UPDATE_DIR}/.status.XXXXXX") || return 1
            if jq -n --arg file "$name" --arg result "$1" --arg error "$2" --arg error_stage "$4" \
                --arg time "$(date -u +%FT%TZ)" --argjson running "$3" \
                --slurpfile previous "$previous" '
                {file: $file, result: $result, time: $time, error: $error, error_stage: $error_stage,
                 running_image: $running,
                 last_successful_update: (if $result == "applied" then $running + {time: $time}
                   else ($previous[0].last_successful_update // null) end)}' > "$tmp" \
                && mv -f "$tmp" "${UPDATE_DIR}/status.json"; then
              return 0
            fi
            echo "Failed to publish update status for ${name}" >&2
            rm -f "$tmp"
            return 1
          }

          # Require JSON encoding before loading an image; see doc/appliance-host-updates.md.
          command -v jq >/dev/null
          mkdir -p /var/lib/data/tmp
          diagnostics=$(mktemp "${UPDATE_DIR}/.diagnostics.XXXXXX")
          trap 'rm -f "$diagnostics"' EXIT
          for tar in "${UPDATE_DIR}"/*.tar; do
            [ -f "$tar" ] || continue
            name=$(basename "$tar")
            echo "Loading agent image from ${tar}..." >&2
            if ! run_with_diagnostics skopeo copy --tmpdir /var/lib/data/tmp/ "oci-archive:${tar}" "containers-storage:{{.AgentImage}}"; then
              echo "Failed to load ${tar}" >&2
              error=$(command_error "Failed to load archive")
              running=$(running_image) || running=null
              write_status failed "$error" "$running" load
              rm -f "$tar"
              continue
            fi

            # Restart now; podman rolls back to the previous image if the new container never becomes healthy.
            result=failed
            error=""
            error_stage=""
            if report=$(run_with_diagnostics podman auto-update --format json); then
              # Other auto-updated units must never determine this appliance's outcome.
              if ! result=$(run_with_diagnostics jq -er '[.[] | select(.Unit == "planner-agent.service") | .Updated]
                  | if length == 1 then .[0] else error("Expected one planner-agent report") end' <<< "$report"); then
                result=failed
                error_stage=report
                error=$(command_error "Invalid planner-agent update report")
              fi
            else
              error_stage=restart
              error=$(command_error "podman auto-update failed")
            fi
            case "$result" in
              true) outcome=applied ;;
              "rolled back") outcome=rolled-back ;;
              false) outcome=unchanged ;;
              failed) outcome=failed; error_stage=${error_stage:-restart}; error=${error:-"planner-agent update failed"} ;;
              *) outcome=failed; error_stage=report; error="Unexpected planner-agent update result: ${result:0:256}" ;;
            esac
            if ! running=$(run_with_diagnostics running_image); then
              running=null
              if [[ "$outcome" == applied ]]; then
                outcome=failed
                error_stage=metadata
                error=$(command_error "Cannot determine running image digest and version")
              fi
            fi
            write_status "$outcome" "$error" "$running" "$error_stage"
            rm -f "$tar"
            if [[ "$outcome" == applied ]]; then
              # Free the previous image only after health and status publication succeed.
              podman image prune -f >/dev/null 2>&1 || true
            fi
          done
    - path: /home/core/.config/systemd/user/planner-agent-image-update.path
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Watch for agent image updates

          [Path]
          PathExistsGlob=/var/lib/data/agent/updates/*.tar

          [Install]
          WantedBy=default.target
    - path: /home/core/.config/systemd/user/planner-agent-image-update.service
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Load updated migration planner agent image

          [Service]
          Type=oneshot
          ExecStart=/usr/local/sbin/update-planner-agent-image.sh
    - path: /home/core/.config/systemd/user/planner-agent-image-load.service
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Load migration planner agent OCI image into local containers storage

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStartPre=/bin/bash -c 'until [ -f /var/lib/data/agent/agent_id ]; do sleep 1; done'
          ExecStart=/usr/local/sbin/load-planner-agent-image.sh

          [Install]
          WantedBy=default.target
    {{ if .Token }}
    - path: /home/core/.migration-planner/jwt.json
      mode: 0644
      contents:
        inline: |
          {{ .Token }}
      user:
        name: core
      group:
        name: core
    {{ end }}
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    - path: /etc/ssh/sshd_config.d/40-rhcos-defaults.conf
      overwrite: true
      contents:
        inline: |
          PasswordAuthentication yes
    - path: /home/core/.migration-planner/agent.env
      contents:
        inline: |
          AGENT_SERVER_HTTP_PORT=3333
          AGENT_SERVER_MODE=prod
          AGENT_API=v2
          AGENT_AUTHENTICATION_ENABLED=true
          AGENT_AUTHENTICATION_JWT_FILEPATH=/app/jwt.json
          AGENT_OPA_POLICIES_FOLDER=/app/policies
          AGENT_SOURCE_ID={{.SourceID}}
          AGENT_DATA_FOLDER=/var/lib/agent
          AGENT_CONSOLE_URL={{.PlannerService}}
          AGENT_SERVER_STATICS_FOLDER=/app/static
          AGENT_LEGACY_STATUS_ENABLED=true
{{ if .HttpProxyUrl }}
          HTTP_PROXY={{ .HttpProxyUrl }}
{{ end }}
{{ if .HttpsProxyUrl }}
          HTTPS_PROXY={{ .HttpsProxyUrl }}
{{ end }}
{{ if .NoProxyDomain }}
          NO_PROXY={{ .NoProxyDomain }}
{{ end }}
      mode: 0644
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/planner-agent.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Planner agent quadlet
          After=planner-agent-image-load.service
          Requires=planner-agent-image-load.service

          [Container]
          Image={{.AgentImage}}
          ContainerName=planner-agent
          Label=io.containers.autoupdate=local
          # Health-gated start: podman auto-update rolls back when the new image never becomes healthy.
          # This checks API startup, not the readability of every collection or database rollback safety.
          HealthCmd=curl -fsk https://localhost:3333/api/v2/version
          HealthInterval=10s
          HealthRetries=6
          HealthStartPeriod=30s
          Notify=healthy
          {{ if .DebugMode }}
          PublishPort=40001:40001
          {{ end }}
          Volume=/var/lib/data/agent:/var/lib/agent:Z
          Volume=/home/core/.migration-planner/jwt.json:/app/jwt.json:Z
          EnvironmentFile=/home/core/.migration-planner/agent.env
          Network=host
          UserNS=keep-id:uid=1001

          [Service]
          # The image is local; a start that never becomes healthy fails and is rolled back.
          TimeoutStartSec=300
          Restart=on-failure
          RestartSec=5
          ExecStartPre=/bin/bash -c 'echo "AGENT_AGENT_ID=$(cat /var/lib/data/agent/agent_id)" >> /home/core/.migration-planner/agent.env'

          [Install]
          WantedBy=multi-user.target default.target
