variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      {{if .RhcosPassword}}
      password_hash: "{{.RhcosPassword}}"
      {{end}}
      {{if .SshKey}}
      ssh_authorized_keys:
        - {{.SshKey}}
      {{end}}

systemd:
  units:
    - name: var-lib-data-resize.service
      enabled: true
      contents: |
        [Unit]
        Description=Resize data disk filesystem
        Before=var-lib-data.mount
        DefaultDependencies=no
        After=local-fs.target

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c '/usr/sbin/resize2fs -f {{ .PersistentDiskDevice }}'
        RemainAfterExit=true

        [Install]
        RequiredBy=var-lib-data.mount
    - name: var-lib-data.mount
      enabled: true
      contents: |
        [Unit]
        Requires=var-lib-data-resize.service
        DefaultDependencies=no
        After=var-lib-data-resize.service

        [Mount]
        What=/dev/disk/by-label/DATA
        Where=/var/lib/data
        Type=ext4

        [Install]
        WantedBy=local-fs.target

    - name: planner-agent-bootstrap.service
      enabled: true
      contents: |
        [Unit]
        Description=Podman custom graphroot SELinux setup and agent ID
        Requires=var-lib-data.mount
        After=var-lib-data.mount

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/podman-custom-selinux.sh
        ExecStart=/bin/bash -c 'cat /sys/class/dmi/id/product_uuid > /var/lib/data/agent/agent_id'
        ExecStart=/bin/bash -c 'chown -R core:core /var/lib/data'

        [Install]
        WantedBy=multi-user.target
storage:
  filesystems:
    - path: /var/lib/data
      device: {{ .PersistentDiskDevice }}
      format: ext4
      label: "DATA"

  links:
    - path: /home/core/.config/systemd/user/default.target.wants/planner-agent-image-load.service
      target: /home/core/.config/systemd/user/planner-agent-image-load.service
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user/default.target.wants/planner-agent-image-update.path
      target: /home/core/.config/systemd/user/planner-agent-image-update.path
      user:
        name: core
      group:
        name: core
  directories:
    - path: /var/lib/data/agent
      user:
        name: core
      group:
        name: core
    - path: /var/lib/data/agent/updates
      user:
        name: core
      group:
        name: core
    - path: /var/lib/data/agent/updates/.staging
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/systemd/user/default.target.wants
      overwrite: true
      user:
        name: core
      group:
        name: core
    - path: /home/core/.migration-planner
      overwrite: true
      user:
        name: core
      group:
        name: core
  files:
    {{if .IpAddress}}
    - path: /etc/NetworkManager/system-connections/static.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=static
          type=ethernet
          autoconnect=true

          [ipv4]
          method=manual
          address1={{.IpAddress}}/{{.SubnetMask}},{{.DefaultGateway}}
          dns={{.Dns}};

          [ipv6]
          method=disabled
    {{end}}
    {{if .InsecureRegistry}}
    - path: /etc/containers/registries.conf.d/myregistry.conf
      overwrite: true
      contents:
        inline: |
          [[registry]]
          location = "{{.InsecureRegistry}}"
          insecure = true
    {{end}}
    - path: /home/core/.config/containers/storage.conf
      overwrite: true
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [storage]
          driver = "overlay"
          runroot = "/var/lib/data/run"
          graphroot = "/var/lib/data/containers/storage"
    - path: /usr/local/sbin/podman-custom-selinux.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          /usr/bin/mkdir -p /var/lib/data/containers/storage /var/lib/data/run
          if [[ ! -f /var/lib/data/podman_storage_selinux_ready ]]; then

            /usr/sbin/semanage fcontext -a -e /var/lib/containers/storage /var/lib/data/containers 2>/dev/null || true
            /usr/sbin/restorecon -vRF /var/lib/data/containers/storage
            /usr/bin/touch /var/lib/data/podman_storage_selinux_ready
          fi
    - path: /usr/local/sbin/load-planner-agent-image.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          if ! command -v skopeo >/dev/null 2>&1; then
            echo "Error: skopeo command not found" >&2
            exit 1
          fi

          readonly IMAGE_TAR=/run/media/iso/images/migration-planner-agent.tar

          if [[ ! -f "$IMAGE_TAR" ]]; then
            echo "Error: Image tar not found at ${IMAGE_TAR}" >&2
            exit 1
          fi

          # Skip if image was already updated (preserves updates across reboots)
          if podman image exists "{{.AgentImage}}" 2>/dev/null; then
            echo "Image {{.AgentImage}} already exists in storage, skipping ISO copy"
            exit 0
          fi

          mkdir -p /var/lib/data/tmp

          exec skopeo copy --tmpdir /var/lib/data/tmp/ \
            "oci-archive:${IMAGE_TAR}" \
            "containers-storage:{{.AgentImage}}"
    - path: /usr/local/sbin/update-planner-agent-image.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -uo pipefail

          # The agent stages archives in updates/.staging/ and renames them here once validated,
          # so every *.tar in this directory is complete and approved for installation.
          readonly UPDATE_DIR=/var/lib/data/agent/updates

          # status.json tells the agent the outcome: applied, rolled-back, failed or unchanged.
          write_status() {
            local file=${1//\\/\\\\}
            file=${file//\"/\\\"}
            printf '{"file":"%s","result":"%s","time":"%s"}\n' "$file" "$2" "$(date -u +%FT%TZ)" > "${UPDATE_DIR}/.status.tmp"
            mv -f "${UPDATE_DIR}/.status.tmp" "${UPDATE_DIR}/status.json"
          }

          mkdir -p /var/lib/data/tmp
          for tar in "${UPDATE_DIR}"/*.tar; do
            [ -f "$tar" ] || continue
            name=$(basename "$tar")
            echo "Loading agent image from ${tar}..." >&2
            if ! skopeo copy --tmpdir /var/lib/data/tmp/ "oci-archive:${tar}" "containers-storage:{{.AgentImage}}"; then
              echo "Failed to load ${tar}" >&2
              rm -f "$tar"
              write_status "$name" failed
              continue
            fi
            rm -f "$tar"

            # Restart now; podman rolls back to the previous image if the new container never becomes healthy.
            result=$(podman auto-update --format '{{"{{"}}.Updated{{"}}"}}' 2>&1 | tail -n1)
            echo "podman auto-update: ${result}" >&2
            case "$result" in
              true)
                # Free the previous image only after the new one is healthy; the data disk is small.
                podman image prune -f >/dev/null 2>&1 || true
                write_status "$name" applied ;;
              "rolled back") write_status "$name" rolled-back ;;
              false) write_status "$name" unchanged ;;
              *) write_status "$name" failed ;;
            esac
          done
    - path: /home/core/.config/systemd/user/planner-agent-image-update.path
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Watch for agent image updates

          [Path]
          PathExistsGlob=/var/lib/data/agent/updates/*.tar

          [Install]
          WantedBy=default.target
    - path: /home/core/.config/systemd/user/planner-agent-image-update.service
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Load updated migration planner agent image

          [Service]
          Type=oneshot
          ExecStart=/usr/local/sbin/update-planner-agent-image.sh
    - path: /home/core/.config/systemd/user/planner-agent-image-load.service
      mode: 0644
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          [Unit]
          Description=Load migration planner agent OCI image into local containers storage

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          ExecStartPre=/bin/bash -c 'until [ -f /var/lib/data/agent/agent_id ]; do sleep 1; done'
          ExecStart=/usr/local/sbin/load-planner-agent-image.sh

          [Install]
          WantedBy=default.target
    {{ if .Token }}
    - path: /home/core/.migration-planner/jwt.json
      mode: 0644
      contents:
        inline: |
          {{ .Token }}
      user:
        name: core
      group:
        name: core
    {{ end }}
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    - path: /etc/ssh/sshd_config.d/40-rhcos-defaults.conf
      overwrite: true
      contents:
        inline: |
          PasswordAuthentication yes
    - path: /home/core/.migration-planner/agent.env
      contents:
        inline: |
          AGENT_SERVER_HTTP_PORT=3333
          AGENT_SERVER_MODE=prod
          AGENT_API=v2
          AGENT_AUTHENTICATION_ENABLED=true
          AGENT_AUTHENTICATION_JWT_FILEPATH=/app/jwt.json
          AGENT_OPA_POLICIES_FOLDER=/app/policies
          AGENT_SOURCE_ID={{.SourceID}}
          AGENT_DATA_FOLDER=/var/lib/agent
          AGENT_CONSOLE_URL={{.PlannerService}}
          AGENT_SERVER_STATICS_FOLDER=/app/static
          AGENT_LEGACY_STATUS_ENABLED=true
{{ if .HttpProxyUrl }}
          HTTP_PROXY={{ .HttpProxyUrl }}
{{ end }}
{{ if .HttpsProxyUrl }}
          HTTPS_PROXY={{ .HttpsProxyUrl }}
{{ end }}
{{ if .NoProxyDomain }}
          NO_PROXY={{ .NoProxyDomain }}
{{ end }}
      mode: 0644
      user:
        name: core
      group:
        name: core
    - path: /home/core/.config/containers/systemd/planner-agent.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Planner agent quadlet
          After=planner-agent-image-load.service
          Requires=planner-agent-image-load.service

          [Container]
          Image={{.AgentImage}}
          ContainerName=planner-agent
          Label=io.containers.autoupdate=local
          # Health-gated start: podman auto-update rolls back when the new image never becomes healthy.
          HealthCmd=curl -fsk https://localhost:3333/api/v2/version
          HealthInterval=10s
          HealthRetries=6
          HealthStartPeriod=30s
          Notify=healthy
          {{ if .DebugMode }}
          PublishPort=40001:40001
          {{ end }}
          Volume=/var/lib/data/agent:/var/lib/agent:Z
          Volume=/home/core/.migration-planner/jwt.json:/app/jwt.json:Z
          EnvironmentFile=/home/core/.migration-planner/agent.env
          Network=host
          UserNS=keep-id:uid=1001

          [Service]
          # The image is local; a start that never becomes healthy fails and is rolled back.
          TimeoutStartSec=300
          Restart=on-failure
          RestartSec=5
          ExecStartPre=/bin/bash -c 'echo "AGENT_AGENT_ID=$(cat /var/lib/data/agent/agent_id)" >> /home/core/.migration-planner/agent.env'

          [Install]
          WantedBy=multi-user.target default.target
