FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/go-toolset AS host-builder
WORKDIR /src
ENV GOTOOLCHAIN=auto
COPY go.mod go.sum ./
COPY cmd/appliance-updater ./cmd/appliance-updater
COPY internal/applianceupdater ./internal/applianceupdater
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -tags remote,containers_image_openpgp -trimpath -buildvcs=false -o /tmp/appliance-updater ./cmd/appliance-updater

FROM --platform=linux/amd64 quay.io/centos/centos:stream9 AS builder
COPY --from=host-builder /tmp/appliance-updater /appliance-updater

ARG ISO_URL ISO_CHECKSUM TLS_VERIFY=true
ARG APPLIANCE_IMAGE=quay.io/redhat-services-prod/assisted-migration-tenant/assisted-migration/oma-appliance
# The appliance image tag is also its version: tag-named releases carry the same
# string in org.opencontainers.image.version (enforced by a check in CI).
ARG APPLIANCE_VERSION

USER root

# Copy the configuration script into the container
COPY build/migration-planner-iso/build-ove-image.sh /tmp/

RUN chmod +x /tmp/build-ove-image.sh

RUN dnf -y update; micro-dnf -y reinstall shadow-utils; \
rm -rf /var/cache /var/log/dnf* /var/log/yum.*

# Do the postprocessing step to generate the OVE ISO
RUN dnf install -y xorriso skopeo rsync syslinux \
 && dnf clean all

# Download the ISO
RUN curl -L --fail --show-error --progress-bar -o /initial-rhcos.iso ${ISO_URL}

# Verify checksum
RUN echo "${ISO_CHECKSUM}  /initial-rhcos.iso" | sha256sum -c -

# Create output directory
RUN mkdir -p /output

# Run the build script with the downloaded ISO file and config values
RUN /tmp/build-ove-image.sh \
    --iso-file /initial-rhcos.iso \
    --dir / \
    --output-file /output/final.iso \
    --agent-image ${APPLIANCE_IMAGE}:${APPLIANCE_VERSION} \
    --tls-verify ${TLS_VERIFY} \
    && rm /initial-rhcos.iso && rm -rf /isomnt

# Final stage with minimal image
FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/ubi-minimal AS final

ARG FINAL_ISO_PATH

# bsdtar reads ISO9660, so the deployment can extract the appliance image tar
# from the ISO rather than this image shipping a second ~1.5 GB copy of it.
RUN microdnf install -y bsdtar && microdnf clean all

COPY --from=builder /output/final.iso ${FINAL_ISO_PATH}

ENTRYPOINT ["/bin/bash"]
