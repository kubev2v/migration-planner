FROM --platform=linux/amd64 quay.io/centos/centos:stream9 AS builder

ARG ISO_URL ISO_CHECKSUM

USER root

# Download the ISO
RUN curl -L --fail --show-error --progress-bar -o /rhcos.iso ${ISO_URL}

# Verify checksum
RUN echo "${ISO_CHECKSUM}  /rhcos.iso" | sha256sum -c -

# Final stage with minimal image
FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/ubi-minimal AS final

ARG FINAL_ISO_PATH

COPY --from=builder /rhcos.iso ${FINAL_ISO_PATH}

ENTRYPOINT ["/bin/bash"]