{{- /*
Host Query - Extracts ESXi host information from vHost sheet.
Falls back to vInfo only when a source host ID is available.

Template Parameters:
  - ClusterFilter: filter by cluster name
  - Limit/Offset: pagination
*/ -}}
WITH vhost_global_count AS (
    SELECT COUNT(*) as cnt FROM vhost
),
vhost_data AS (
    SELECT
        CASE WHEN UPPER(TRIM(COALESCE(h."Datacenter", ''))) IN ('', 'VM') THEN '' ELSE TRIM(h."Datacenter") END AS "datacenter",
        CASE WHEN UPPER(TRIM(COALESCE(h."Cluster", ''))) IN ('', 'VM') THEN '' ELSE TRIM(h."Cluster") END as "cluster",
        COALESCE(h."# Cores", 0)::integer as "cpuCores",
        COALESCE(h."# CPU", 0)::integer as "cpuSockets",
        COALESCE(h."Object ID", '') as "id",
        COALESCE(h."# Memory", 0)::integer as "memoryMB",
        COALESCE(h."Model", 'N/A') as "model",
        COALESCE(h."Vendor", 'N/A') as "vendor",
        COALESCE(h."CPU Model", '') as "cpuModel",
        COALESCE(h."Serial Number", '') as "serialNumber",
        COALESCE(h."VMotion support", false) as "vmotionSupported",
        COALESCE(h."Storage VMotion support", false) as "storageVmotionSupported"
    FROM vhost h
    WHERE 1=1
    {{- if .ClusterFilter }} AND h."Cluster" = '{{.ClusterFilter}}'{{end}}
),
vinfo_fallback AS (
    SELECT
        CASE WHEN COUNT(DISTINCT CASE
                 WHEN UPPER(TRIM(COALESCE("Datacenter", ''))) NOT IN ('', 'VM') THEN TRIM("Datacenter") END) = 1
             THEN MAX(CASE WHEN UPPER(TRIM(COALESCE("Datacenter", ''))) NOT IN ('', 'VM') THEN TRIM("Datacenter") END)
             ELSE '' END AS "datacenter",
        CASE WHEN UPPER(TRIM(COALESCE("Cluster", ''))) IN ('', 'VM') THEN '' ELSE TRIM("Cluster") END as "cluster",
        0 as "cpuCores",
        0 as "cpuSockets",
        TRIM("Host ID") as "id",
        0 as "memoryMB",
        'N/A' as "model",
        'N/A' as "vendor",
        '' as "cpuModel",
        '' as "serialNumber",
        false as "vmotionSupported",
        false as "storageVmotionSupported"
    FROM vinfo
    WHERE NULLIF(TRIM(COALESCE("Host ID", '')), '') IS NOT NULL
      AND COALESCE("migration_excluded", false) = false
    {{- if .ClusterFilter }} AND "Cluster" = '{{.ClusterFilter}}'{{end}}
    GROUP BY CASE WHEN UPPER(TRIM(COALESCE("Cluster", ''))) IN ('', 'VM') THEN '' ELSE TRIM("Cluster") END,
        TRIM("Host ID")
)
SELECT "datacenter", "cluster", "cpuCores", "cpuSockets", "id", "memoryMB", "model", "vendor", "cpuModel", "serialNumber", "vmotionSupported", "storageVmotionSupported"
FROM vhost_data
WHERE (SELECT cnt FROM vhost_global_count) > 0
UNION ALL
SELECT "datacenter", "cluster", "cpuCores", "cpuSockets", "id", "memoryMB", "model", "vendor", "cpuModel", "serialNumber", "vmotionSupported", "storageVmotionSupported"
FROM vinfo_fallback
WHERE (SELECT cnt FROM vhost_global_count) = 0
{{- if and .Limit (gt .Limit 0) }} LIMIT {{.Limit}}{{end}}
{{- if and .Offset (gt .Offset 0) }} OFFSET {{.Offset}}{{end}};
