{{- /*
Disk Type Summary Query Template - Returns disk usage aggregated by datastore type.

Template Parameters:
  - ClusterFilter: filter by cluster name
  - VMListFilter: filter by list of VM IDs
*/ -}}
WITH {{.StorageTopology}},
vm_disk_types AS (
    SELECT
        d."VM ID",
        ds."Type" AS disk_type,
        d."Capacity MiB"
    FROM vdisk d
    JOIN storage_disk_datastores resolved
        ON resolved."VM ID" = d."VM ID" AND resolved.disk_row_id = d.rowid
    JOIN storage_datastores ds ON ds.datastore_row_id = resolved.datastore_row_id
    JOIN vinfo i ON d."VM ID" = i."VM ID"
    WHERE ds."Type" IS NOT NULL AND ds."Type" != ''
      AND COALESCE(i."migration_excluded", false) = false
    {{- if .ClusterFilter }} AND i."Cluster" = '{{.ClusterFilter}}'{{end}}
    {{- .VMListFilter}}
)
SELECT
    disk_type AS type,
    COUNT(DISTINCT "VM ID") AS vm_count,
    ROUND(SUM("Capacity MiB") / 1048576.0, 2) AS total_size_tb
FROM vm_disk_types
GROUP BY disk_type;
