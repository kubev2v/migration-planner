CREATE OR REPLACE TEMP TABLE vMultiPath_normalized AS
SELECT
    CASE WHEN UPPER(TRIM(COALESCE("Host", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Host") END AS "Host",
    CASE WHEN UPPER(TRIM(COALESCE("Disk", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Disk") END AS "Disk",
    CASE WHEN UPPER(TRIM(COALESCE("Vendor", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Vendor") END AS "Vendor",
    CASE WHEN UPPER(TRIM(COALESCE("Model", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Model") END AS "Model",
    CASE WHEN UPPER(TRIM(COALESCE("UUID", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("UUID") END AS "UUID",
    CASE WHEN UPPER(TRIM(COALESCE("Object ID", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Object ID") END AS "Object ID",
    CASE WHEN UPPER(TRIM(COALESCE("Path 1", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 1") END AS "Path 1",
    CASE WHEN UPPER(TRIM(COALESCE("Path 2", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 2") END AS "Path 2",
    CASE WHEN UPPER(TRIM(COALESCE("Path 3", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 3") END AS "Path 3",
    CASE WHEN UPPER(TRIM(COALESCE("Path 4", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 4") END AS "Path 4",
    CASE WHEN UPPER(TRIM(COALESCE("Path 5", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 5") END AS "Path 5",
    CASE WHEN UPPER(TRIM(COALESCE("Path 6", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 6") END AS "Path 6",
    CASE WHEN UPPER(TRIM(COALESCE("Path 7", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 7") END AS "Path 7",
    CASE WHEN UPPER(TRIM(COALESCE("Path 8", ''))) IN ('', 'VM') THEN NULL ELSE TRIM("Path 8") END AS "Path 8"
FROM vMultiPath_raw;

WITH path_records AS (
    SELECT
        h."Host ID",
        NULLIF(TRIM(path.adapter_device), '') AS hba_device,
        NULLIF(TRIM(m."Disk"), '') AS canonical_name,
        NULLIF(TRIM(m."Vendor"), '') AS lun_vendor,
        NULLIF(TRIM(m."Model"), '') AS lun_model,
        NULLIF(TRIM(m."UUID"), '') AS lun_uuid
    FROM vMultiPath_normalized m
    LEFT JOIN rvtools_host_map h ON h.source_key = LOWER(TRIM(m."Host"))
    CROSS JOIN UNNEST([
        m."Path 1", m."Path 2", m."Path 3", m."Path 4",
        m."Path 5", m."Path 6", m."Path 7", m."Path 8"
    ]) AS path(adapter_device)
    WHERE m."Disk" IS NOT NULL
      AND path.adapter_device IS NOT NULL
),
unassociated_records AS (
    SELECT
        h."Host ID",
        NULL::VARCHAR AS hba_device,
        NULLIF(TRIM(m."Disk"), '') AS canonical_name,
        NULLIF(TRIM(m."Vendor"), '') AS lun_vendor,
        NULLIF(TRIM(m."Model"), '') AS lun_model,
        NULLIF(TRIM(m."UUID"), '') AS lun_uuid
    FROM vMultiPath_normalized m
    LEFT JOIN rvtools_host_map h ON h.source_key = LOWER(TRIM(m."Host"))
    WHERE m."Disk" IS NOT NULL
      AND COALESCE(
          m."Path 1", m."Path 2", m."Path 3", m."Path 4",
          m."Path 5", m."Path 6", m."Path 7", m."Path 8"
      ) IS NULL
)
INSERT INTO vhostscsi ("Host ID", "HBA Device", "SCSI Disk Key", "Canonical Name", "LUN Vendor", "LUN Model", "LUN UUID")
SELECT DISTINCT "Host ID", hba_device, NULL, canonical_name, lun_vendor, lun_model, lun_uuid
FROM path_records
UNION
SELECT DISTINCT "Host ID", hba_device, NULL, canonical_name, lun_vendor, lun_model, lun_uuid
FROM unassociated_records;

WITH multipath_backing AS (
    SELECT
        "Object ID" AS datastore_id,
        CAST(to_json(
            list(DISTINCT "Disk" ORDER BY "Disk") FILTER (WHERE "Disk" IS NOT NULL)
        ) AS VARCHAR) AS backing_devices
    FROM vMultiPath_normalized
    WHERE "Object ID" IS NOT NULL
    GROUP BY "Object ID"
)
INSERT INTO vdatastore (
    "Hosts", "Address", "Name", "Object ID", "Free MiB", "MHA", "Capacity MiB", "Type",
    "Filesystem Type", "Filesystem Major Version", "Backing Devices", "Storage Protocol",
    "SIOC Enabled", "SIOC Congestion Threshold", "SIOC Congestion Threshold Mode", "SIOC Percent Of Peak Throughput"
)
SELECT
    d."Hosts",
    d."Address",
    d."Name",
    d."Object ID",
    TRY_CAST(d."Free MiB" AS DOUBLE),
    CASE WHEN LOWER(d."MHA") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(d."MHA") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    TRY_CAST(d."Capacity MiB" AS DOUBLE),
    d."Type",
    CASE
        WHEN UPPER(TRIM(COALESCE(d."Type", ''))) IN ('NFS4.1', 'NFS 4.1') THEN 'NFS41'
        ELSE NULLIF(UPPER(TRIM(d."Type")), '')
    END,
    CASE
        WHEN UPPER(TRIM(COALESCE(d."Type", ''))) = 'VMFS'
         AND TRY_CAST(d."Major Version" AS INTEGER) > 0
        THEN TRY_CAST(d."Major Version" AS INTEGER)
        ELSE NULL
    END,
    COALESCE(
        b.backing_devices,
        CASE
            WHEN UPPER(TRIM(COALESCE(d."Type", ''))) = 'VMFS'
             AND TRY_CAST(d."# Extents" AS INTEGER) = 1
			AND regexp_matches(LOWER(TRIM(COALESCE(d."Address", ''))), '^(naa\.|eui\.|t10\.|mpx\.|vml\.|nvme\.).+')
            THEN CAST(to_json([TRIM(d."Address")]) AS VARCHAR)
            ELSE '[]'
        END
    ),
    CASE
        WHEN UPPER(TRIM(COALESCE(d."Type", ''))) IN ('NFS', 'NFS41', 'NFS4.1', 'NFS 4.1') THEN 'NFS'
        ELSE NULL
    END,
    CASE WHEN LOWER(TRIM(COALESCE(d."SIOC Enabled", ''))) IN ('true', '1', 'yes') THEN true ELSE false END,
    COALESCE(TRY_CAST(d."SIOC Congestion Threshold" AS INTEGER), 30),
    CASE WHEN LOWER(TRIM(COALESCE(d."SIOC Congestion Threshold Mode", ''))) = 'manual' THEN 'manual' ELSE 'automatic' END,
    COALESCE(TRY_CAST(d."SIOC Percent Of Peak Throughput" AS INTEGER), 90)
FROM vdatastore_raw d
LEFT JOIN multipath_backing b ON b.datastore_id = d."Object ID";

DROP TABLE IF EXISTS vdatastore_raw;
DROP TABLE IF EXISTS rvtools_host_map;
DROP TABLE IF EXISTS vMultiPath_normalized;
DROP TABLE IF EXISTS vMultiPath_raw;

INSERT INTO vnetwork (
    "VM ID", "Network", "Mac Address", "NIC label", "Adapter", "Switch",
    "Connected", "Starts Connected", "Type", "IPv4 Address", "IPv6 Address", "Cluster"
)
SELECT
    n."VM ID",
    n."Network",
    n."Mac Address",
    n."NIC label",
    n."Adapter",
    n."Switch",
    CASE WHEN LOWER(n."Connected") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(n."Connected") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    CASE WHEN LOWER(n."Starts Connected") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(n."Starts Connected") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    n."Type",
    n."IPv4 Address",
    n."IPv6 Address",
    n."Cluster"
FROM read_xlsx('{{.FilePath}}', sheet='vNetwork', all_varchar=true) n
WHERE n."VM ID" IN (SELECT "VM ID" FROM vinfo);

INSERT INTO dvport ("Port", "VLAN", "Switch")
SELECT "Port", "VLAN", "Switch"
FROM read_xlsx('{{.FilePath}}', sheet='dvPort', all_varchar=true);

INSERT INTO dvswitch ("Name")
SELECT DISTINCT "Name"
FROM read_xlsx('{{.FilePath}}', sheet='dvSwitch', all_varchar=true);

CREATE TABLE vcluster_raw AS
SELECT * FROM read_xlsx('{{.FilePath}}', sheet='vCluster', all_varchar=true);

ALTER TABLE vcluster_raw ADD COLUMN IF NOT EXISTS "DRS enabled" VARCHAR;
ALTER TABLE vcluster_raw ADD COLUMN IF NOT EXISTS "DRS default VM behavior" VARCHAR;
ALTER TABLE vcluster_raw ADD COLUMN IF NOT EXISTS "HA enabled" VARCHAR;

INSERT INTO vcluster ("Name", "Object ID", "DrsEnabled", "DrsDefaultVmBehavior", "DasEnabled")
SELECT "Name", "Object ID",
    CASE
        WHEN LOWER(TRIM(COALESCE("DRS enabled", ''))) IN ('true', '1', 'yes', 'enabled') THEN true
        ELSE false
    END as "DrsEnabled",
    COALESCE(NULLIF(TRIM("DRS default VM behavior"), ''), 'None') as "DrsDefaultVmBehavior",
    CASE
        WHEN LOWER(TRIM(COALESCE("HA enabled", ''))) IN ('true', '1', 'yes', 'enabled') THEN true
        ELSE false
    END as "DasEnabled"
FROM vcluster_raw;

-- DuckDB's XLSX reader can resolve RVTools empty shared-string cells as
-- "VM", the existing RVTools empty-value placeholder. A real cluster named
-- exactly "VM" is therefore unsupported by this RVTools import.
UPDATE vhost SET "Cluster" = '' WHERE "Cluster" = 'VM';
