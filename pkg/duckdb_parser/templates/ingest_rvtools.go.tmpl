ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "VI SDK UUID" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "VI SDK Server type" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "VI SDK API Version" VARCHAR;

-- Legacy RVTools headers (pre-3.9 vCenter UUID, MB vs MiB, disk.EnableUUID): ensure columns exist, then fold into canonical names used below.
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "vCenter UUID" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "Provisioned MB" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "In use MB" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "In Use MB" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "In use MiB" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "SMBIOS UUID" VARCHAR;
ALTER TABLE vinfo_raw ADD COLUMN IF NOT EXISTS "disk.EnableUUID" VARCHAR;

UPDATE vinfo_raw SET
  "VI SDK UUID" = COALESCE(
    NULLIF(TRIM("VI SDK UUID"), ''),
    NULLIF(TRIM("vCenter UUID"), '')
  ),
  "In Use MiB" = COALESCE(
    NULLIF(TRIM("In Use MiB"), ''),
    NULLIF(TRIM("In use MiB"), ''),
    NULLIF(TRIM("In Use MB"), ''),
    NULLIF(TRIM("In use MB"), '')
  ),
  "Provisioned MiB" = COALESCE(
    NULLIF(TRIM("Provisioned MiB"), ''),
    NULLIF(TRIM("Provisioned MB"), '')
  ),
  "EnableUUID" = COALESCE(
    NULLIF(TRIM("EnableUUID"), ''),
    NULLIF(TRIM("disk.EnableUUID"), '')
  );

INSERT INTO vinfo (
    "VM ID", "VM", "Annotation", "Folder ID", "Folder", "Host", "SMBIOS UUID", "VM UUID",
    "Firmware", "Powerstate", "Connection state", "FT State",
    "CPUs", "Memory",
    "OS according to the configuration file", "OS according to the VMware Tools",
    "DNS Name", "Primary IP Address", "In Use MiB",
    "Template", "CBT", "EnableUUID",
    "Datacenter", "Cluster", "HW version",
    "Total disk capacity MiB", "Provisioned MiB", "Resource pool", "VI SDK UUID"
)
SELECT
    "VM ID",
    "VM",
    "Annotation",
    "Folder ID",
    "Folder",
    "Host",
    COALESCE(
        NULLIF(TRIM("SMBIOS UUID"), ''),
        NULLIF(TRIM("VM UUID"), '')
    ),
    NULLIF(TRIM("VM UUID"), ''),
    "Firmware",
    "Powerstate",
    "Connection state",
    "FT State",
    TRY_CAST("CPUs" AS INTEGER),
    TRY_CAST("Memory" AS INTEGER),
    NULLIF("OS according to the configuration file", 'VM'),
    NULLIF("OS according to the VMware Tools", 'VM'),
    NULLIF("DNS Name", 'VM'),
    "Primary IP Address",
    TRY_CAST("In Use MiB" AS INTEGER),
    CASE WHEN LOWER("Template") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER("Template") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    CASE WHEN LOWER("CBT") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER("CBT") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    CASE WHEN LOWER("EnableUUID") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER("EnableUUID") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    "Datacenter",
    "Cluster",
    "HW version",
    NULL,
    TRY_CAST("Provisioned MiB" AS INTEGER),
    "Resource pool",
    "VI SDK UUID"
FROM vinfo_raw
WHERE "VM" IS NOT NULL AND "VM" != ''
  AND "VM ID" IS NOT NULL AND TRIM("VM ID") != ''
  AND LOWER(COALESCE("Template", '')) NOT IN ('true', '1', 'yes')
ON CONFLICT DO NOTHING;

{{if .HasMetadata}}
WITH metadata AS (
    SELECT key AS vm_id, from_json(value, '"MAP(VARCHAR, VARCHAR[])"') AS entries
    FROM json_each(?)
)
INSERT INTO vm_metadata (vm_id, key, value)
SELECT DISTINCT metadata.vm_id, entry.key, unnest(entry.value) AS value
FROM metadata
JOIN vinfo_raw source ON source."VM ID" = metadata.vm_id
JOIN vinfo vm ON vm."VM ID" = metadata.vm_id AND vm."VI SDK UUID" = source."VI SDK UUID",
    unnest(map_entries(metadata.entries)) m(entry)
WHERE source."VM" IS NOT NULL AND source."VM" != ''
    AND LOWER(COALESCE(source."Template", '')) NOT IN ('true', '1', 'yes')
ON CONFLICT DO NOTHING;
{{end}}

-- Stage source metadata so an absent vMetaData sheet does not lose vCenter details.
CREATE TABLE about_raw AS
SELECT DISTINCT "VI SDK API Version", "VI SDK Server type", "VI SDK UUID",
    NULL::TIMESTAMP AS "CollectionTime"
FROM vinfo_raw;

-- Excel export dates have no timezone; assume UTC.
UPDATE about_raw SET "CollectionTime" = (
    SELECT TRY_STRPTIME(
        COALESCE(
            TRY(excel_text(
                TRY_CAST(TRIM("xlsx creation datetime") AS DOUBLE),
                'yyyy/mm/dd hh:mm:ss'
            )),
            TRIM("xlsx creation datetime")
        ),
        '%Y/%m/%d %H:%M:%S'
    )
    FROM read_xlsx('{{.FilePath}}', sheet='vMetaData', header=true, all_varchar=true)
    WHERE LOWER(TRIM("xlsx creation datetime")) NOT IN ('', 'vm')
);

INSERT INTO about ("APIVersion", "Product", "InstanceUuid", "CollectionTime")
SELECT DISTINCT "VI SDK API Version", "VI SDK Server type", "VI SDK UUID", "CollectionTime"
FROM about_raw
WHERE "VI SDK UUID" IS NOT NULL
ORDER BY "VI SDK API Version" IS NOT NULL DESC;

DROP TABLE about_raw;

WITH cleaned_networks AS (
    SELECT
        "VM ID",
        list(net_val) FILTER (WHERE net_val != 'VM' AND net_val IS NOT NULL) as net_array
    FROM vinfo_raw
    UNPIVOT (
        net_val FOR net_col IN (COLUMNS('Network #.*'))
    )
    GROUP BY "VM ID"
)
UPDATE vinfo
SET
    "Network #1" = net_array[1],
    "Network #2" = net_array[2],
    "Network #3" = net_array[3],
    "Network #4" = net_array[4],
    "Network #5" = net_array[5],
    "Network #6" = net_array[6],
    "Network #7" = net_array[7],
    "Network #8" = net_array[8]
FROM cleaned_networks
WHERE vinfo."VM ID" = cleaned_networks."VM ID";

-- vinfo_raw is kept for schema validation to distinguish missing VM ID / VM name errors.
-- It is dropped after ValidateSchema completes in IngestRvTools.

INSERT INTO vcpu ("VM ID", "Hot Add", "Hot Remove", "Sockets", "Cores p/s")
SELECT
    c."VM ID",
    CASE WHEN LOWER(c."Hot Add") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(c."Hot Add") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    CASE WHEN LOWER(c."Hot Remove") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(c."Hot Remove") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    TRY_CAST(c."Sockets" AS INTEGER),
    TRY_CAST(c."Cores p/s" AS INTEGER)
FROM read_xlsx('{{.FilePath}}', sheet='vCPU', all_varchar=true) c
WHERE c."VM ID" IN (SELECT "VM ID" FROM vinfo);

INSERT INTO vmemory ("VM ID", "Hot Add", "Ballooned")
SELECT
    m."VM ID",
    CASE WHEN LOWER(m."Hot Add") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(m."Hot Add") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    TRY_CAST(m."Ballooned" AS INTEGER)
FROM read_xlsx('{{.FilePath}}', sheet='vMemory', all_varchar=true) m
WHERE m."VM ID" IN (SELECT "VM ID" FROM vinfo);

