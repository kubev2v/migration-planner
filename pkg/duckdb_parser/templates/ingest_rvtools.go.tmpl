-- Resolve RVTools host names without linking ambiguous names to an arbitrary host.
CREATE OR REPLACE TEMP TABLE rvtools_host_map AS
SELECT LOWER(TRIM("Host")) AS source_key, "Object ID" AS "Host ID"
FROM vhost
WHERE NULLIF(TRIM("Host"), '') IS NOT NULL
  AND NULLIF(TRIM("Object ID"), '') IS NOT NULL
  AND LOWER(TRIM("Host")) IN (
      SELECT LOWER(TRIM("Host"))
      FROM vhost
      WHERE NULLIF(TRIM("Host"), '') IS NOT NULL
      GROUP BY LOWER(TRIM("Host"))
      HAVING COUNT(*) = 1
  );

-- vHBA is optional in partial RVTools exports.
CREATE OR REPLACE TEMP TABLE vhba_raw AS
SELECT * FROM read_xlsx('{{.FilePath}}', sheet='vHBA', all_varchar=true);
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "Host" VARCHAR;
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "Device" VARCHAR;
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "Type" VARCHAR;
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "Model" VARCHAR;
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "Driver" VARCHAR;
ALTER TABLE vhba_raw ADD COLUMN IF NOT EXISTS "WWN" VARCHAR;

INSERT INTO vhba ("Host ID", "Device", "Type", "HBA Key", "Protocol", "Model", "Driver", "Node WWN", "Port WWN")
SELECT DISTINCT
    h."Host ID",
    CASE WHEN UPPER(TRIM(COALESCE(a."Device", ''))) IN ('', 'VM') THEN NULL ELSE TRIM(a."Device") END,
    CASE WHEN UPPER(TRIM(COALESCE(a."Type", ''))) IN ('', 'VM') THEN NULL ELSE TRIM(a."Type") END,
    NULL,
    CASE UPPER(TRIM(COALESCE(a."Type", '')))
        WHEN 'ISCSI' THEN 'iSCSI'
        WHEN 'FIBRE CHANNEL' THEN 'FibreChannel'
        ELSE NULL
    END,
    CASE WHEN UPPER(TRIM(COALESCE(a."Model", ''))) IN ('', 'VM') THEN NULL ELSE TRIM(a."Model") END,
    CASE WHEN UPPER(TRIM(COALESCE(a."Driver", ''))) IN ('', 'VM') THEN NULL ELSE TRIM(a."Driver") END,
    CASE
        WHEN regexp_matches(TRIM(COALESCE(a."WWN", '')), '^[0-9A-Fa-f]{16}[[:space:]]+[0-9A-Fa-f]{16}$')
        THEN LOWER(regexp_extract(TRIM(a."WWN"), '^([0-9A-Fa-f]{16})[[:space:]]+[0-9A-Fa-f]{16}$', 1))
        ELSE NULL
    END,
    CASE
        WHEN regexp_matches(TRIM(COALESCE(a."WWN", '')), '^[0-9A-Fa-f]{16}[[:space:]]+[0-9A-Fa-f]{16}$')
        THEN LOWER(regexp_extract(TRIM(a."WWN"), '^[0-9A-Fa-f]{16}[[:space:]]+([0-9A-Fa-f]{16})$', 1))
        ELSE NULL
    END
FROM vhba_raw a
LEFT JOIN rvtools_host_map h ON h.source_key = LOWER(TRIM(a."Host"))
WHERE UPPER(TRIM(COALESCE(a."Device", ''))) NOT IN ('', 'VM');

DROP TABLE IF EXISTS vhba_raw;

