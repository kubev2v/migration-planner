INSERT INTO vdisk (
    "VM ID", "Disk Key", "Unit #", "Path", "Disk Path", "Capacity MiB",
    "Sharing mode", "Raw", "Shared Bus", "Disk Mode", "Disk UUID", "RDM LUN UUID",
    "Thin", "Controller", "Label", "SCSI Unit #"
)
SELECT
    d."VM ID",
    d."Disk Key",
    d."Unit #",
    d."Path",
    d."Disk Path",
    TRY_CAST(d."Capacity MiB" AS BIGINT),
    CASE WHEN LOWER(d."Sharing mode") IN ('true', '1', 'yes', 'sharingmultiwriter') THEN TRUE WHEN LOWER(d."Sharing mode") IN ('false', '0', 'no', 'sharingnone') THEN FALSE ELSE NULL END,
    CASE WHEN LOWER(d."Raw") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(d."Raw") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    d."Shared Bus",
    d."Disk Mode",
    d."Disk UUID",
    CASE WHEN LOWER(d."Raw") IN ('true', '1', 'yes') THEN NULLIF(TRIM(d."Raw LUN ID"), '') END,
    CASE WHEN LOWER(d."Thin") IN ('true', '1', 'yes') THEN TRUE WHEN LOWER(d."Thin") IN ('false', '0', 'no') THEN FALSE ELSE NULL END,
    d."Controller",
    d."Label",
    d."SCSI Unit #"
FROM vdisk_raw d
WHERE d."VM ID" IN (SELECT "VM ID" FROM vinfo);

