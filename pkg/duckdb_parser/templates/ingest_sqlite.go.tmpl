{{- /*
Ingest SQLite Template - Inserts data from forklift SQLite database into pre-created schema tables.

Strategy:
  - Tables must be created first using create_schema.go.tmpl
  - Uses INSERT INTO ... SELECT to map SQLite columns to schema columns
  - Transforms the normalized forklift/vsphere model into flat RVTools-style tables

Key transformations:
  - VM → vinfo: Direct 1:1 field mapping with derived Cluster and Datacenter
  - VM.NICs (JSON array) → vnetwork rows via LATERAL unnest
  - VM.Disks (JSON array) → vdisk rows via LATERAL unnest
  - Host → vhost with memory converted from bytes to MiB
  - Host HBA array → vhba adapter inventory
  - Host topology/SCSI disk arrays → distinct vhostscsi host/adapter/LUN associations
  - Datastore → vdatastore with capacity/free converted from bytes to MiB and storage protocol joined by backing device
  - Network → dvport for distributed virtual switches
  - Cluster → vcluster: Name, anonymized Object ID (SHA-256), DasEnabled (HA), DrsEnabled and DrsDefaultVmBehavior (DRS)

Standalone hosts:
  forklift models a host with no cluster as a synthetic ComputeResource "cluster" (Variant = 'ComputeResource', named
  after the host) rather than leaving the cluster empty. RVTools-shape output has no such concept: a standalone host has
  a blank Cluster and does not appear in vCluster. So the placeholder is normalized away here - blanked as a cluster name
  in vinfo/vhost/vnetwork (its parent chain is kept so the host still resolves to a Datacenter) and excluded from vcluster.
*/ -}}

ATTACH '{{.FilePath}}' AS src (TYPE sqlite);

INSERT INTO vinfo (
    "VM ID", "VM", "Folder ID", "Folder", "Host", "SMBIOS UUID", "VM UUID",
    "Firmware", "Powerstate", "Connection state", "FT State",
    "CPUs", "Memory",
    "OS according to the configuration file", "OS according to the VMware Tools",
    "DNS Name", "Primary IP Address", "In Use MiB",
    "Template", "CBT", "EnableUUID",
    "Datacenter", "Cluster", "HW version",
    "Total disk capacity MiB", "Provisioned MiB", "Resource pool", "VI SDK UUID",
    "migration_excluded", "labels", "guest_apps"
)
SELECT
    v.ID,
    v.Name,
    v.Folder,
    v.Folder,
    v.Host,
    v.UUID,
    v.UUID,
    v.Firmware,
    v.PowerState,
    v.ConnectionState,
    CASE WHEN v.FaultToleranceEnabled = 1 THEN 'enabled' ELSE 'notConfigured' END,
    v.CpuCount,
    v.MemoryMB,
    v.GuestName,
    v.GuestNameFromVmwareTools,
    v.HostName,
    v.IpAddress,
    v.StorageUsed / 1048576,
    v.IsTemplate = 1,
    v.ChangeTrackingEnabled = 1,
    v.DiskEnableUuid = 1,
    d.Name,
    CASE WHEN c.Variant = 'ComputeResource' THEN '' ELSE c.Name END,
    '',
    0,
    0,
    '',
    about.InstanceUuid,
    false,
    '[]',
    COALESCE(v.GuestApps, '[]')
FROM src.VM v
LEFT JOIN src.Host h ON v.Host = h.ID
LEFT JOIN src.Cluster c ON h.Cluster = c.ID
LEFT JOIN src.Folder f ON c.Parent->>'id' = f.ID
LEFT JOIN src.Datacenter d ON f.Datacenter = d.ID
CROSS JOIN (SELECT InstanceUuid FROM src.About LIMIT 1) about
WHERE v.IsTemplate = 0
ON CONFLICT DO NOTHING;

-- Read optional fields through JSON to support older SQLite exports.
WITH metadata AS (
    SELECT v.ID AS id,
        category.name AS key,
        tag.value->>'name' AS value
    FROM src.VM v,
        json_each(COALESCE(to_json(v)->>'Tags', '[]')) tag
    JOIN temp.main.tag_categories category ON category.id = (tag.value->>'categoryID')
    WHERE v.IsTemplate = 0 AND trim(tag.value->>'name') != '' AND trim(category.name) != ''
    UNION ALL
    SELECT v.ID AS id, def.value->>'name' AS key, val.value->>'value' AS value
    FROM src.VM v,
        json_each(COALESCE(to_json(v)->>'CustomValues', '[]')) val,
        json_each(COALESCE(to_json(v)->>'CustomDef', '[]')) def
    WHERE v.IsTemplate = 0 AND (val.value->>'key') = (def.value->>'key')
        AND trim(val.value->>'value') != '' AND trim(def.value->>'name') != ''
)
INSERT INTO vm_metadata (vm_id, key, value)
SELECT DISTINCT metadata.id, metadata.key, metadata.value
FROM metadata
JOIN vinfo vm ON vm."VM ID" = metadata.id
CROSS JOIN (SELECT InstanceUuid FROM src.About LIMIT 1) about
WHERE vm."VI SDK UUID" = about.InstanceUuid
ON CONFLICT DO NOTHING;

INSERT INTO vcpu ("VM ID", "Hot Add", "Hot Remove", "Sockets", "Cores p/s")
SELECT
    v.ID,
    v.CpuHotAddEnabled = 1,
    v.CpuHotRemoveEnabled = 1,
    v.CpuCount / NULLIF(v.CoresPerSocket, 0),
    v.CoresPerSocket
FROM src.VM v
WHERE v.ID IN (SELECT "VM ID" FROM vinfo);

INSERT INTO vmemory ("VM ID", "Hot Add", "Ballooned")
SELECT
    v.ID,
    v.MemoryHotAddEnabled = 1,
    v.BalloonedMemory
FROM src.VM v
WHERE v.ID IN (SELECT "VM ID" FROM vinfo);

INSERT INTO vdisk (
    "VM ID", "Disk Key", "Unit #", "Path", "Disk Path", "Capacity MiB",
    "Sharing mode", "Raw", "Shared Bus", "Disk Mode", "Disk UUID", "RDM LUN UUID",
    "Thin", "Controller", "Label", "SCSI Unit #"
)
SELECT
    v.ID,
    disk->>'key',
    disk->>'unitNumber',
    disk->>'file',
    disk->>'file',
    (disk->>'capacity')::bigint / 1048576,
    disk->>'shared' = 'true',
    disk->>'rdm' = 'true',
    disk->>'bus',
    disk->>'mode',
    disk->>'serial',
    CASE WHEN disk->>'rdm' = 'true' THEN NULLIF(TRIM(disk->>'lunUuid'), '') END,
    false,
    disk->>'bus',
    '',
    disk->>'unitNumber'
FROM src.VM v,
LATERAL unnest(from_json(v.Disks, '[{"key":"INTEGER","unitNumber":"INTEGER","file":"VARCHAR","capacity":"BIGINT","shared":"BOOLEAN","rdm":"BOOLEAN","bus":"VARCHAR","mode":"VARCHAR","serial":"VARCHAR","lunUuid":"VARCHAR"}]')) AS t(disk)
WHERE v.Disks != '[]' AND v.ID IN (SELECT "VM ID" FROM vinfo);

WITH nic_flat AS (
    SELECT
        v.ID AS vm_id,
        v.IpAddress,
        v.GuestNetworks,
        nic.mac AS mac_addr,
        nic.network.id AS network_id,
        h.Cluster AS cluster_id
    FROM src.VM v
    LEFT JOIN src.Host h ON v.Host = h.ID,
    LATERAL unnest(from_json(v.NICs, '[{"network":{"kind":"VARCHAR","id":"VARCHAR"},"mac":"VARCHAR","order":"INTEGER","deviceKey":"INTEGER"}]')) AS t(nic)
    WHERE v.NICs != '[]' AND v.ID IN (SELECT "VM ID" FROM vinfo)
),
gn_flat AS (
    SELECT
        nf.vm_id,
        nf.mac_addr AS nic_mac,
        gn.mac AS gn_mac,
        gn.ip
    FROM nic_flat nf,
    LATERAL unnest(from_json(COALESCE(NULLIF(nf.GuestNetworks, ''), '[]'),
        '[{"mac":"VARCHAR","ip":"VARCHAR","prefix":"INTEGER","device":"VARCHAR","network":"VARCHAR","origin":"VARCHAR","deviceConfigId":"INTEGER"}]'
    )) AS t2(gn)
)
INSERT INTO vnetwork (
    "VM ID", "Network", "Mac Address", "NIC label", "Adapter", "Switch",
    "Connected", "Starts Connected", "Type", "IPv4 Address", "IPv6 Address", "Cluster"
)
SELECT
    nf.vm_id,
    n.Name,
    nf.mac_addr,
    '',
    '',
    COALESCE(n.DVSwitch->>'id', ''),
    true,
    true,
    CASE WHEN n.DVSwitch->>'id' IS NOT NULL THEN 'distributed' ELSE 'standard' END,
    COALESCE(
        (SELECT gf.ip FROM gn_flat gf
         WHERE gf.vm_id = nf.vm_id AND gf.nic_mac = nf.mac_addr AND gf.gn_mac = nf.mac_addr
           AND gf.ip LIKE '%.%'
         LIMIT 1),
        nf.IpAddress
    ),
    COALESCE(
        (SELECT gf.ip FROM gn_flat gf
         WHERE gf.vm_id = nf.vm_id AND gf.nic_mac = nf.mac_addr AND gf.gn_mac = nf.mac_addr
           AND gf.ip LIKE '%:%'
         LIMIT 1),
        ''
    ),
    CASE WHEN c.Variant = 'ComputeResource' THEN '' ELSE c.Name END
FROM nic_flat nf
LEFT JOIN src.Cluster c ON nf.cluster_id = c.ID
LEFT JOIN src.Network n ON nf.network_id = n.ID;

INSERT INTO about ("APIVersion", "Product", "InstanceUuid")
SELECT
    a.APIVersion,
    a.Product,
    a.InstanceUuid
FROM src.About a;

INSERT INTO vhost ("Datacenter", "Cluster", "# Cores", "# CPU", "Object ID", "# Memory", "Model", "Vendor", "Host", "Config status",
    "VMotion support", "Storage VMotion support")
SELECT
    d.Name,
    CASE WHEN c.Variant = 'ComputeResource' THEN '' ELSE c.Name END,
    h.CpuCores,
    h.CpuSockets,
    h.ID,
    h.MemoryBytes / 1048576,
    h.Model,
    h.Vendor,
    h.ID,
    'green',
    COALESCE(h.VMotionSupported, false),
    COALESCE(h.StorageVMotionSupported, false)
FROM src.Host h
-- Keep standalone-host ancestry to resolve its datacenter, but blank the cluster name.
LEFT JOIN src.Cluster c ON h.Cluster = c.ID
LEFT JOIN src.Folder f ON c.Parent->>'id' = f.ID
LEFT JOIN src.Datacenter d ON f.Datacenter = d.ID;

INSERT INTO vhba ("Host ID", "Device", "HBA Key", "Protocol", "Model", "Driver", "Node WWN", "Port WWN")
SELECT DISTINCT
    h.ID,
    NULLIF(TRIM(hba.hbaDevice), ''),
    NULLIF(TRIM(hba.key), ''),
    CASE WHEN LOWER(TRIM(hba.protocol)) != 'unknown' THEN NULLIF(TRIM(hba.protocol), '') END,
    NULLIF(TRIM(hba.model), ''),
    NULLIF(TRIM(hba.driver), ''),
    NULLIF(TRIM(hba.nodeWorldWideName), ''),
    NULLIF(TRIM(hba.portWorldWideName), '')
FROM src.Host h,
LATERAL unnest(TRY(from_json(COALESCE(NULLIF(h.HbaDiskInfo, ''), '[]'),
        '[{"hbaDevice":"VARCHAR","protocol":"VARCHAR","model":"VARCHAR","driver":"VARCHAR","nodeWorldWideName":"VARCHAR","portWorldWideName":"VARCHAR","key":"VARCHAR"}]'
))) AS t(hba);

WITH host_topology_luns AS (
    SELECT DISTINCT
        h.ID AS host_id,
        topology.key AS hba_key,
        lun_key AS scsi_disk_key
    FROM src.Host h,
    LATERAL unnest(TRY(from_json(COALESCE(NULLIF(h.HostScsiTopology, ''), '[]'),
        '[{"key":"VARCHAR","scsiDiskKeys":["VARCHAR"]}]'
    ))) AS t(topology),
    LATERAL unnest(topology.scsiDiskKeys) AS lun(lun_key)
),
host_scsi_disks AS (
    SELECT
        h.ID AS host_id,
        disk.key AS scsi_disk_key,
        disk.canonicalName AS canonical_name,
        disk.vendor AS vendor,
        disk.model AS model
    FROM src.Host h,
    LATERAL unnest(TRY(from_json(COALESCE(NULLIF(h.HostScsiDisks, ''), '[]'),
        '[{"canonicalName":"VARCHAR","vendor":"VARCHAR","model":"VARCHAR","key":"VARCHAR"}]'
    ))) AS t(disk)
)
INSERT INTO vhostscsi (
    "Host ID", "HBA Device", "SCSI Disk Key", "Canonical Name", "LUN Vendor", "LUN Model"
)
SELECT DISTINCT
    COALESCE(disk.host_id, topology.host_id),
    hba."Device",
    COALESCE(disk.scsi_disk_key, topology.scsi_disk_key),
    NULLIF(TRIM(disk.canonical_name), ''),
    NULLIF(TRIM(disk.vendor), ''),
    NULLIF(TRIM(disk.model), '')
FROM host_scsi_disks disk
FULL OUTER JOIN host_topology_luns topology
    ON disk.host_id = topology.host_id AND disk.scsi_disk_key = topology.scsi_disk_key
LEFT JOIN vhba hba ON hba."Host ID" = topology.host_id AND hba."HBA Key" = topology.hba_key;

-- Read optional storage fields through JSON so older snapshots retain their datastores.
WITH datastore_metadata AS (
    SELECT
        ds.*,
        NULLIF(to_json(ds)->>'FilesystemType', '') AS filesystem_type,
        NULLIF(TRY_CAST(to_json(ds)->>'FilesystemMajorVersion' AS INTEGER), 0) AS filesystem_major_version,
        NULLIF(TRIM(to_json(ds)->>'ProtocolEndpointType'), '') AS protocol_endpoint_type
    FROM src.Datastore ds
)
INSERT INTO vdatastore ("Hosts", "Address", "Name", "Object ID", "Free MiB", "MHA", "Capacity MiB", "Type", "Filesystem Type", "Filesystem Major Version", "Backing Devices", "Storage Protocol",
    "SIOC Enabled", "SIOC Congestion Threshold", "SIOC Congestion Threshold Mode", "SIOC Percent Of Peak Throughput")
SELECT
    string_agg(DISTINCT h.ID, ','),
    ds.Name,
    ds.Name,
    ds.ID,
    ds.Free / 1048576,
    ds.MaintenanceMode = 'True',
    ds.Capacity / 1048576,
    ds.Type,
    ds.filesystem_type,
    ds.filesystem_major_version,
    CAST(to_json(COALESCE(
        TRY(from_json(NULLIF(ds.BackingDevicesNames, ''), '["VARCHAR"]')),
        []::VARCHAR[]
    )) AS VARCHAR),
    COALESCE((
        SELECT string_agg(DISTINCT hba."Protocol", ', ' ORDER BY hba."Protocol")
        FROM vhostscsi path
        JOIN vhba hba ON hba."Host ID" = path."Host ID" AND hba."Device" = path."HBA Device"
        JOIN src.Host storage_host ON storage_host.ID = path."Host ID"
        CROSS JOIN LATERAL unnest(COALESCE(
            TRY(from_json(COALESCE(NULLIF(storage_host.Datastores, ''), '[]'),
                '[{"kind":"VARCHAR","id":"VARCHAR"}]'
            )),
            []::STRUCT(kind VARCHAR, id VARCHAR)[]
        )) AS refs(datastore_ref)
        CROSS JOIN LATERAL unnest(COALESCE(
            TRY(from_json(NULLIF(ds.BackingDevicesNames, ''), '["VARCHAR"]')),
            []::VARCHAR[]
        )) AS devices(backing_device)
        WHERE datastore_ref.id = ds.ID
          AND path."Canonical Name" = backing_device
          AND NULLIF(TRIM(hba."Protocol"), '') IS NOT NULL
          AND LOWER(TRIM(hba."Protocol")) != 'unknown'
    ), ds.protocol_endpoint_type, CASE
        WHEN UPPER(COALESCE(ds.filesystem_type, ds.Type)) IN ('NFS', 'NFS41') THEN 'NFS'
        ELSE NULL
    END),
    COALESCE(ds.IORMEnabled, false),
    COALESCE(ds.IORMCongestionThreshold, 30),
    COALESCE(ds.IORMCongestionThresholdMode, 'automatic'),
    COALESCE(ds.IORMPercentOfPeakThroughput, 90)
FROM datastore_metadata ds
LEFT JOIN (
    SELECT h.ID, h.Cluster, dsref->>'id' AS datastore_id
    FROM src.Host h,
    LATERAL unnest(COALESCE(
        TRY(from_json(COALESCE(NULLIF(h.Datastores, ''), '[]'), '[{"kind":"VARCHAR","id":"VARCHAR"}]')),
        []::STRUCT(kind VARCHAR, id VARCHAR)[]
    )) AS t(dsref)
) h ON h.datastore_id = ds.ID
GROUP BY ds.ID, ds.Name, ds.Free, ds.Capacity, ds.MaintenanceMode, ds.Type, ds.filesystem_type, ds.filesystem_major_version, ds.BackingDevicesNames, ds.protocol_endpoint_type,
    COALESCE(ds.IORMEnabled, false), COALESCE(ds.IORMCongestionThreshold, 30),
    COALESCE(ds.IORMCongestionThresholdMode, 'automatic'), COALESCE(ds.IORMPercentOfPeakThroughput, 90);

INSERT INTO dvport ("Port", "VLAN")
SELECT
    n.Name,
    n.VlanId
FROM src.Network n
WHERE COALESCE(n.DVSwitch->>'id', '') != '';

{{/* Cluster ID hash duplicates generateClusterID (inventory_builder.go); keep in sync. Guarded by TestIngestSqlite_PopulatesVCluster. */}}
INSERT INTO vcluster ("Name", "Object ID", "DrsEnabled", "DrsDefaultVmBehavior", "DasEnabled")
SELECT
    c.Name,
    'cluster-' || substring(sha256(about.InstanceUuid || ':' || COALESCE(d.Name, '') || ':' || c.Name), 1, 16),
    c.DrsEnabled,
    COALESCE(NULLIF(TRIM(c.DrsBehavior), ''), 'None'),
    c.DasEnabled
FROM src.Cluster c
LEFT JOIN src.Folder f ON c.Parent->>'id' = f.ID
LEFT JOIN src.Datacenter d ON f.Datacenter = d.ID
CROSS JOIN (SELECT InstanceUuid FROM src.About LIMIT 1) about
-- Skip forklift synthetic ComputeResource placeholders (standalone hosts, not real clusters)
WHERE c.Variant != 'ComputeResource';

DETACH src;

-- Populate Network # columns in vinfo from vnetwork table
WITH network_arrays AS (
    SELECT
        "VM ID",
        list("Network") AS networks
    FROM vnetwork
    GROUP BY "VM ID"
)
UPDATE vinfo SET
    "Network #1" = networks[1],
    "Network #2" = networks[2],
    "Network #3" = networks[3],
    "Network #4" = networks[4],
    "Network #5" = networks[5],
    "Network #6" = networks[6],
    "Network #7" = networks[7],
    "Network #8" = networks[8]
FROM network_arrays
WHERE vinfo."VM ID" = network_arrays."VM ID";
